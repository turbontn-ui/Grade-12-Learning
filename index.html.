  if(details.length!==currentQuestions.length){alert("Please answer every question before marking.");return;}
  const subject = document.getElementById("quizSubject").value;
  const attempt={id:Date.now(),date:new Date().toISOString(),subject:subject==="life"?"Life Sciences":"Agricultural Sciences",score,total:currentQuestions.length,percent:Math.round(score/currentQuestions.length*100)};
  const progress=loadProgress(); progress.unshift(attempt); saveProgress(progress.slice(0,100));
