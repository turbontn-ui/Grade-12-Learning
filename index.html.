  result.innerHTML="";
  const box=document.createElement("div");box.className="result";
  const title=document.createElement("strong");title.textContent=`Your score: ${score}/${currentQuestions.length} (${attempt.percent}%)`;
  const message=document.createElement("p");message.textContent=attempt.percent>=80?"Excellent work! Review any explanations below.":attempt.percent>=50?"Good effort. Review the explanations and try again.":"Keep practising. Read the notes and try the quiz again.";
  box.append(title,message);
